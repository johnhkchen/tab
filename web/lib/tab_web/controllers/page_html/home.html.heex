<Layouts.app flash={@flash} current_scope={@current_scope}>
  <header class="space-y-3 pt-6">
    <h1 class="text-5xl font-semibold tracking-tight">Tab</h1>
    <p class="text-xl text-ink-soft">
      Keeps the running tab for your house, so nobody has to.
    </p>
  </header>

  <section class="clay-surface space-y-3 p-6">
    <p>
      Log what you spent, see who owes whom, and settle up. Your housemates see the
      shared bills. Your own spending stays yours, and the database itself enforces that.
    </p>
    <.button navigate={~p"/users/log-in"}>Sign in or start</.button>
  </section>

  <footer class="flex flex-wrap gap-3 text-sm">
    <a class="clay-chip px-3 py-1.5" href="https://github.com/johnhkchen/tab">Read the code</a>
    <a class="clay-chip px-3 py-1.5" href={~p"/healthz"}>Check it's running</a>
  </footer>
</Layouts.app>
