---
import type { BlockComponentProps } from 'emdash/ui';
import type { PageContentBlock } from '../../../emdash-env';

type Props = BlockComponentProps<Extract<PageContentBlock, { _type: 'intro' }>>;

const { heading, lede } = Astro.props.value;
---

<h1>{heading}</h1>
{lede && <p class="lede">{lede}</p>}
