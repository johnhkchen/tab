---
import { sanitizeHref } from 'emdash';
import type { BlockComponentProps } from 'emdash/ui';
import type { PageContentBlock } from '../../../emdash-env';

type Props = BlockComponentProps<Extract<PageContentBlock, { _type: 'buttons' }>>;

const { buttons } = Astro.props.value;
---

<div class="actions">
	{
		buttons.map((button) => (
			<a class:list={['clay-button', { 'clay-button--soft': button.soft }]} href={sanitizeHref(button.url)}>
				{button.label}
			</a>
		))
	}
</div>
