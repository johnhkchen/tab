---
// The pricing page: the EmDash page with the slug "pricing". Plan cards come
// from its `plans` block, which reads src/data/plans.ts.
//
// Each EmDash page gets its own small route file like this one, not a
// catch-all `[slug].astro`: a catch-all would also catch /docs/, which belongs
// to the prerendered Starlight docs.
import { getEmDashEntry } from 'emdash';
import PageView from '../components/PageView.astro';
import Page from '../layouts/Page.astro';

const { entry: page, cacheHint } = await getEmDashEntry('pages', 'pricing');
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
if (!page) Astro.response.status = 404;
---

<Page title="Pricing · Tab" description={page?.data.description ?? ''}>
	{
		page ? (
			<PageView page={page} />
		) : (
			<>
				<h1>Pricing</h1>
				<p class="lede">This page isn't up yet.</p>
				{Astro.locals.user && (
					<p class="note">
						<a href="/_emdash/admin/content/pages/new">Make a page</a> with the slug "pricing" and
						publish it.
					</p>
				)}
			</>
		)
	}
</Page>
