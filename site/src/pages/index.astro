---
// The landing page: the EmDash page with the slug "home".
import { getEmDashEntry } from 'emdash';
import PageView from '../components/PageView.astro';
import Page from '../layouts/Page.astro';

const { entry: page, cacheHint } = await getEmDashEntry('pages', 'home');
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const fallback = 'Keeps the running tab for your house, so nobody has to.';
---

<Page title="Tab" description={page?.data.description || fallback}>
	{
		page ? (
			<PageView page={page} />
		) : (
			<>
				<h1>Tab</h1>
				<p class="lede">{fallback}</p>
				{Astro.locals.user && (
					<p class="note">
						There's no home page yet. <a href="/_emdash/admin/content/pages/new">Make a page</a> with
						the slug "home" and publish it.
					</p>
				)}
			</>
		)
	}
</Page>
